# =====================================================================
#  BAGZINIC  -  .env.example   (ye sirf NAMOONA hai, isme asli password na likho)
#
#  Kaise use karna hai:
#   1) Is file ki copy banao aur naam rakho:   .env      (aage "example" nahi)
#   2) Neeche har line mein "=" ke baad apni value likho (bina quotes, bina space)
#   3) .env ko kisi ko mat bhejna aur GitHub par upload mat karna
#
#  Line "#" se shuru ho to wo sirf note hai, uska koi asar nahi.
# =====================================================================

# ---------- 1) DATABASE (Neon se milta hai) ----------
# Neon dashboard > Connection string copy karo. Ye "postgresql://" se shuru hoti hai.
DATABASE_URL=postgresql://neondb_owner:npg_VFWnYz7ick2v@ep-withered-shadow-aos9rlw0-pooler.c-2.ap-southeast-1.aws.neon.tech/bagzinic?sslmode=require&channel_binding=require

# ---------- 2) ADMIN LOGIN (aap khud banate ho) ----------
# Admin panel ka username aur password. Ye aap ki marzi se kuch bhi ho sakta hai.
ADMIN_USER=bagzinic_admin
ADMIN_PASS=Bagzinic@78622

# ---------- 3) JWT SECRET (login ki tala-chabi) ----------
# Koi lamba random text (kam se kam 32 huroof). README mein bataya hai kaise banana hai.
JWT_SECRET=e4823f715fb37a550c3a45185f4671c4102015a830ee3030c1ed3be4bd59ede2

# ---------- 4) EMAIL (inquiry/CV/messages aap ki email par ane ke liye) ----------
# Gmail ke liye ye 3 lines aise hi rehne do (sirf USER aur PASS badlo).
SMTP_HOST=Bagzinicindustries@gmail.com
SMTP_PORT=465
# Aap ki Gmail address jis se email bheji jayegi
SMTP_USER=Bagzinicindustries@gmail.com
# Gmail "App Password" (16 huroof). Gmail ka normal password NAHI.
SMTP_PASS=abcdefghijklmnop
# Ye email jahan sab inquiries aur CV milenge (khali chhodo to SMTP_USER hi use hoga)
MAIL_TO=Bagzinicindustries@gmail.com

# ---------- 5) OPTIONAL ----------
# Jab domain kharid lo tab likho, jaise https://bagzinic.com  (abhi khali chhod sakte ho)
SITE_URL=https://bagzinic-website.onrender.com
# Computer par chalane ka port (Render par ye khud set hota hai)
PORT=3000
